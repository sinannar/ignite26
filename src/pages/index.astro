---
import Keynote from '../keynote/Keynote';
import { event } from '../deck/content';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{event.name} · Announcements</title>
    <meta name="description" content={`${event.name}: an interactive walkthrough of the announcements.`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <Keynote client:only="react" />
  </body>
</html>
