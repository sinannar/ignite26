---
import Keynote from '../keynote/Keynote';
import { announcements, event, sections } from '../data/announcements';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{event.name} · {event.subtitle}</title>
    <meta name="description" content={`${event.name} announcements`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <Keynote client:load event={event} sections={sections} announcements={announcements} />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
