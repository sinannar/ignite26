---
// The speaker notes now live in the presenter view; keep the short URL working.
const target = `${import.meta.env.BASE_URL}?presenter=1`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Presenter view</title>
    <script is:inline define:vars={{ target }}>location.replace(target + location.hash);</script>
  </head>
  <body>
    <a href={target}>Open the presenter view</a>
  </body>
</html>
