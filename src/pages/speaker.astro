---
import SpeakerNotes from '../speaker/SpeakerNotes';
import { event } from '../deck/content';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Unlisted: not linked from the deck, kept out of search engines. -->
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>Speaker notes · {event.name}</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <style is:global>
      @import '../styles/speaker.css';
    </style>
  </head>
  <body>
    <SpeakerNotes client:only="react" />
  </body>
</html>
